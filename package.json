    "axios": "^1.6.2",
    "dompurify": "^3.2.3",
    "dotenv": "^16.3.1",
    "firebase": "^10.14.1",
    "gsap": "^3.12.5",
    "naija-state-local-government": "^1.1.2",
    "paystack": "^2.0.1",
